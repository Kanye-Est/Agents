# Copy to hello-agents-lab/.env on the L40 machine.
# The vLLM endpoint is loopback-only, so no real API secret is required.

LLM_API_KEY=EMPTY
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_MODEL_ID=qwen3-32b-awq
LLM_TIMEOUT=300
# Passed to vLLM on every request through OpenAI's extra_body field.
LLM_CHAT_TEMPLATE_KWARGS={"enable_thinking":false}

# Reproducibility metadata recorded with each evaluation result.
LLM_MODEL_REVISION=0499c3ac83fdef8810b907a23894ba91e95eddd8
LLM_BACKEND=vllm
LLM_BACKEND_VERSION=0.10.2
LLM_QUANTIZATION=awq
LLM_DTYPE=float16
