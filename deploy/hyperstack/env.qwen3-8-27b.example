# Copy to hello-agents-lab/.env on the L40 machine (kan-aad-l40).
# Spec: idea/52 Amendment 2 §A2.2. The vLLM endpoint is loopback-only, so no real
# API secret is required. Values here MUST stay consistent with
# serve_qwen3_8_27b_awq_native_fc.sh (SERVED_NAME) for readiness gate G-a.

LLM_API_KEY=EMPTY
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_MODEL_ID=qwen3-8-27b-awq
LLM_TIMEOUT=300
# Think-off is part of the measured scaffold; enforced per-request AND by the
# --chat-template thinkoff jinja. Fixed within the experiment (README_L40 discipline).
LLM_CHAT_TEMPLATE_KWARGS={"enable_thinking":false}
# Decode determinism: temperature 0 is set by the client (Goose GOOSE_TEMPERATURE=0 /
# eval harness); engine seed 0 is pinned in the serve script (--seed 0).

# Reproducibility metadata recorded with each evaluation result.
# PIN LLM_MODEL_REVISION at deploy from the R5 download (== the serve script's
# MODEL_REVISION == the G-d weights manifest revision). Left blank on purpose —
# do not invent a hash.
LLM_MODEL_REVISION=
LLM_BACKEND=vllm
LLM_BACKEND_VERSION=0.10.2
LLM_QUANTIZATION=awq
LLM_DTYPE=float16
